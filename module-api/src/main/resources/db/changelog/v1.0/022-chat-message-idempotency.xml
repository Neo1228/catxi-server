<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="022-add-chat-message-client-id" author="catxi">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="chat_message" columnName="client_message_id"/>
            </not>
        </preConditions>
        <addColumn tableName="chat_message">
            <column name="client_message_id" type="VARCHAR(36)"/>
        </addColumn>
    </changeSet>

    <changeSet id="022-index-chat-message-client-id" author="catxi">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="chat_message" indexName="uk_chat_message_client_request"/>
            </not>
        </preConditions>
        <createIndex tableName="chat_message" indexName="uk_chat_message_client_request" unique="true">
            <column name="chat_room_id"/>
            <column name="member_id"/>
            <column name="client_message_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
