<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="034-create-chat-message-broadcast-outbox" author="catxi-team">
        <comment>채팅 메시지 저장과 실시간 전달 요청을 같은 트랜잭션에서 기록합니다.</comment>

        <createTable tableName="chat_message_broadcast_outbox">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="message_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uk_chat_message_broadcast_message_id"/>
            </column>
            <column name="payload" type="JSON">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="retry_count" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="next_attempt_at" type="TIMESTAMP(6)"
                    defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="lease_owner" type="VARCHAR(128)"/>
            <column name="lease_until" type="TIMESTAMP(6)"/>
            <column name="created_at" type="TIMESTAMP(6)"
                    defaultValueComputed="CURRENT_TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="TIMESTAMP(6)"/>
            <column name="error_message" type="TEXT"/>
        </createTable>

        <createIndex indexName="idx_chat_broadcast_outbox_due"
                     tableName="chat_message_broadcast_outbox">
            <column name="status"/>
            <column name="next_attempt_at"/>
            <column name="id"/>
        </createIndex>
        <createIndex indexName="idx_chat_broadcast_outbox_sent"
                     tableName="chat_message_broadcast_outbox">
            <column name="status"/>
            <column name="sent_at"/>
        </createIndex>
        <rollback>
            <dropTable tableName="chat_message_broadcast_outbox"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
