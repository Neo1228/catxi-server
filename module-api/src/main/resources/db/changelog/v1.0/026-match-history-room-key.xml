<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="026-match-history-room-key" author="catxi-team">
        <addColumn tableName="match_history">
            <column name="room_id" type="BIGINT"/>
        </addColumn>
        <createIndex tableName="match_history"
                     indexName="uk_match_history_room_member"
                     unique="true">
            <column name="room_id"/>
            <column name="member_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="match_history" indexName="uk_match_history_room_member"/>
            <dropColumn tableName="match_history" columnName="room_id"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
